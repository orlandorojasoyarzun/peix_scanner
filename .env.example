APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Spanish-only product. config/app.php falls back to 'es' if the env
# var is missing, so this section only needs to exist if you want a
# different locale for staging or QA.
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# Local dev defaults to SQLite for zero-config setup. In any deployed
# environment (Railway, Render, Fly, etc.) override this to pgsql/mysql
# via the platform's secret manager — DO NOT commit production credentials
# to the repo. The current production target is PostgreSQL on Railway.
DB_CONNECTION=sqlite

# ---- PostgreSQL on Railway (production) ----
# Railway's Postgres plugin injects a single DATABASE_URL like
#   postgresql://user:pass@host:port/db?sslmode=require
# Setting DB_URL makes Laravel parse the connection from that one var,
# so DB_HOST/PORT/etc below can stay commented in production. In local
# dev we keep the per-field defaults for convenience.
#
# Production (Railway dashboard → service variables):
#   DB_CONNECTION=pgsql
#   DB_URL=<railway-provided-postgres-url>
#   DB_SSLMODE=require
#   SESSION_DRIVER=database  (uses Postgres sessions table)
#   CACHE_STORE=database     (uses Postgres cache table)
#   QUEUE_CONNECTION=database
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=prefer
# ---- /PostgreSQL ----

# ------------------------------------------------------------------
# Session
# ------------------------------------------------------------------
# SESSION_ENCRYPT=true encrypts session payload at rest. The cost is
# negligible (AES on a small payload) and it prevents session contents
# from being readable if the cache/session table leaks.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# In production behind HTTPS, force the session cookie to be Secure.
# Leave commented out for local HTTP dev.
# SESSION_SECURE_COOKIE=true

# ------------------------------------------------------------------
# Caches / queues
# ------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# AWS / S3
# ------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Third-party API keys
# ------------------------------------------------------------------
# SECURITY: These keys are tied to paid / metered services. NEVER commit
# a real value to git. Leave the placeholder here and inject the real
# value via the platform's secret manager (Railway Variables, etc.).
#
# If a key ever leaks (committed by mistake, leaked in logs, exposed in a
# public backup) rotate it immediately at the provider — assume compromise.
# ------------------------------------------------------------------

# OpenRouter (vision + text generation). Rotate at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# USDA FoodData Central (nutrition lookups). Rotate at https://fdc.nal.usda.gov/api-key-request/
USDA_API_KEY=
